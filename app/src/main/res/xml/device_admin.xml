<?xml version="1.0" encoding="utf-8"?>
<!-- Políticas declaradas para la ruta Device Owner (requiere adb). No bastan solas para interceptar el botón de encendido. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <disable-keyguard-features />
        <disable-camera />
    </uses-policies>
</device-admin>
